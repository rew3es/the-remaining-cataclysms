[sub_resource type="GDScript" id="GDScript_c6nfn"]
script/source = "extends Node2D

@export var character: CharacterBody2D

var geometry: Array[Node2D] = []
var thershold: Dictionary = {}
var overlapsed: Dictionary = {}


func _ready() -> void:
	for obj in get_children():

		if not obj is Node2D:
			continue

		var point = obj.get_node_or_null(\"effect_trigger_threshold\")

		if not point is Node2D:
			continue

		geometry.append(obj)
		thershold[obj] = point
		overlapsed[obj] = false

	print(geometry)


func _process(_delta: float) -> void:
	for obj in geometry:

		if thershold[obj].global_position.y > character.global_position.y and not overlapsed[obj]:
			character.z_index = obj.z_index - 1
			overlapsed[obj] = true

		elif thershold[obj].global_position.y < character.global_position.y and overlapsed[obj]:
			character.z_index = obj.z_index + 1
			overlapsed[obj] = false
"

